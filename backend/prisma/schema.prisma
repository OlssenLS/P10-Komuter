datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  username           String   @unique
  password           String
  name               String
  avatarUrl          String?
  points             Int      @default(0)
  level              Int      @default(1)
  role               Role     @default(COMMUTER)
  hashedRefreshToken String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  reports            DisruptionReport[] @relation("ReportAuthor")

  @@map("users")
}

enum Role {
  COMMUTER
  ADMIN
  MODERATOR
}

enum TransportType {
  KRL
  MRT
  LRTJKT
  LRTJBK
  TJ
  TRANSIT
}

enum ReportCategory {
  CROWD       // Low, Normal, High crowd density & safety alerts
  DELAY       // Train/bus schedule delays
  FACILITY    // Broken station facilities & amenities
  DISRUPTION  // Operational emergencies: closures, flooding, signal failure
}

enum ReportSubCategory {
  // Crowd Subcategories & Safety
  LOW
  NORMAL
  HIGH
  VERY_HIGH

  // Delay Subcategories
  MINOR               // < 5 minutes
  MEDIUM              // 5 - 15 minutes
  MAJOR               // > 15 minutes

  // Facility Subcategories
  ESCALATOR
  LIFT
  TAP_IN_OUT_GATE
  TOILET

  // Disruption Subcategories (Operational Emergencies)
  FLOOD_WEATHER
  POWER_SIGNAL
  TRACK_INCIDENT
  FIRE_SMOKE
  STATION_CLOSED
  MEDICAL_SECURITY
}

enum ReportStatus {
  PENDING_QUORUM      // 1-2 reports (waiting for 3-user quorum)
  ACTIVE              // Confirmed live state (visible on feeds)
  RESOLVED            // Cleared by "Sudah Normal" consensus
  EXPIRED             // Passed TTL
}

model Station {
  id                String             @id @default(cuid())
  name              String 
  isTransitHub      Boolean            @default(false)
  supportedTypes    TransportType[]
  lineNames         String[]
  latitude          Float
  longitude         Float
  validDestinations Json               @default("[]")

  // Relations for disruption reports
  liveStatus         StationLiveStatus?
  reports            DisruptionReport[] @relation("StationReports")
  destinationReports DisruptionReport[] @relation("DestinationStationReports")

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model StationLiveStatus {
  stationId       String   @id
  station         Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)

  // { low: number, medium: number, high: number, very_high: number, updatedAt: ISOString }
  crowdState      Json     @default("{}")

  // Map<"{lineId}:{destinationId}", { destinationName, minorCount, mediumCount, majorCount, topNotes: string[], expiresAt }>
  delayState      Json     @default("{}")

  // Map<FacilitySubCategory, { status: "OPERATIONAL" | "BROKEN", reportCount, resolvedCount, topNote, lastConfirmedAt }>
  facilityState   Json     @default("{}")

  // Map<DisruptionSubCategory, { status: "PENDING_QUORUM" | "ACTIVE", reportCount, resolvedCount, isSkippedOrClosed, affectedLineIds: string[], topNote, startedAt, expiresAt }>
  disruptionState Json     @default("{}")

  updatedAt       DateTime @updatedAt

  @@map("station_live_statuses")
}

model DisruptionReport {
  id                   String            @id @default(cuid())
  
  // Reporter & Audit
  userId               String
  user                 User              @relation("ReportAuthor", fields: [userId], references: [id], onDelete: Cascade)
  
  // Classification
  category             ReportCategory
  subCategory          ReportSubCategory
  note                 String?           @db.VarChar(120) // Optional 1-line commuter context (replaces free-text title)

  // Spatial & Directional Context
  stationId            String
  station              Station           @relation("StationReports", fields: [stationId], references: [id], onDelete: Cascade)
  lineId               String?           // e.g. "krl-bogor", "tj-koridor-9"
  destinationStationId String?           // System-constrained terminus for DELAY
  destinationStation   Station?          @relation("DestinationStationReports", fields: [destinationStationId], references: [id], onDelete: SetNull)
  
  // Action Flags
  isSkippedOrClosed    Boolean           @default(false) // True if station is bypassed/closed due to disruption
  isResolution         Boolean           @default(false) // True if user tapped "Sudah Normal"

  // Geofence Audit
  userLatitude         Float?
  userLongitude        Float?

  // Lifecycle
  status               ReportStatus      @default(ACTIVE)
  expiresAt            DateTime

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  // Fast Idempotency & Cooldown Check (1 report per user per station/category window)
  @@index([userId, stationId, category, createdAt])
  @@index([stationId, category, status, expiresAt])
  @@map("disruption_reports")
}
