# ==============================================================================
# Komuter Shared Environment Configuration Template
# ==============================================================================
# Host LAN IP: Update this with your machine's IPv4 address from `ipconfig`
# whenever you switch Wi-Fi / network. Mobile app will automatically connect here.
SERVER_IP=10.253.9.190
PORT=3000

# Backend PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/komuter_db?schema=public"

# JWT Authentication Secrets & Expiration
JWT_ACCESS_SECRET="replace_with_a_secure_long_random_access_token_secret"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="replace_with_a_secure_long_random_refresh_token_secret"
JWT_REFRESH_EXPIRES_IN="7d"
